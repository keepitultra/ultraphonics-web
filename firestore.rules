rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Band admins. Deliberately a separate collection that NOBODY can write
    // through the client: allowedUsers is self-updatable (so sign-in can sync a
    // profile), so a role flag stored there could be granted to oneself.
    // Seeded with scripts/seed-admins.mjs via the Admin SDK.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The member record this signed-in user owns, if any.
    function ownsMember(memberId) {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(memberId)).data.googleUid == request.auth.uid;
    }

    // Fields only an admin may change: band-operational flags that affect how
    // setlists are generated, plus googleUid, which decides whose record this
    // is and must never be self-assignable.
    function touchesAdminOnlyFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['googleUid', 'canSingLead', 'type', 'active', 'sortOrder', 'roles', 'fullName']);
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Central allowlist — used by all protected collections
    function isAllowedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    // Membership is granted by a document EXISTING here, so `create` must stay
    // denied — otherwise any Google account could authorise itself by writing
    // its own doc. Signed-in users may only update the doc they already have,
    // which is what lets AuthContext.syncMemberProfile() store their name,
    // photo and email on sign-in. Allowlisted users can read the whole
    // collection so the admin can show real names and photos.
    match /allowedUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAllowedUser());
      allow update: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if false;
    }

    // Shows: public read, allowlisted write
    match /shows/{showId} {
      allow read: if true;
      allow write: if isAllowedUser();
    }

    // Songs: public read, allowlisted write
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAllowedUser();
    }

    // Setlists: public read, allowlisted write
    match /setlists/{setlistId} {
      allow read: if true;
      allow write: if isAllowedUser();
    }

    // Clients: allowlisted read/write only
    match /clients/{clientId} {
      allow read, write: if isAllowedUser();

      match /activityLogs/{logId} {
        allow read, write: if isAllowedUser();
      }
    }

    // ── Quote requests ──────────────────────────────────────────────────
    // The public /quote form writes these while signed out, so `create` is the
    // one door an anonymous visitor gets. Unlike songRequests below it is not
    // simply propped open: an exact key set (nothing extra can be smuggled in),
    // capped string lengths, closed option lists, and status pinned to 'New' so
    // nobody can post a pre-'Won' lead. receivedAt must equal server time, so
    // the admin list's sort order cannot be gamed by lying about createdAt.
    //
    // Reads stay allowlisted — a quote holds a name, email and phone number, so
    // an anonymous get or list must never resolve.
    //
    // These option lists MUST stay in step with QUOTE_OPTIONS in
    // src/utils/quoteForm.js, which is what renders the form. Adding an option
    // there without redeploying rules silently rejects every submission using it.
    function quoteKeys() {
      return [
        'id','name','email','phone','eventType','eventTypeOther','date','location',
        'venue','setting','guests','duration','hardStop','bandSize','openToRec',
        'services','genres','sound','lighting','budget','urgency','notes',
        'status','createdAt','receivedAt','source',
        'utmSource','utmMedium','utmCampaign','referrer'
      ];
    }
    function qStr(v, max)           { return v is string && v.size() <= max; }
    function qOpt(v, options)       { return v is string && (v == '' || v in options); }
    function qList(v, options, max) { return v is list && v.size() <= max && v.toSet().hasOnly(options); }

    function isValidNewQuote(quoteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(quoteKeys()) && d.keys().hasAll(quoteKeys())
        && d.id == quoteId
        && d.status == 'New'
        && d.source == 'web'
        && d.receivedAt == request.time
        && qStr(d.createdAt, 40)
        && qStr(d.name, 120)     && d.name.size() > 0
        && qStr(d.email, 200)    && d.email.matches('^[^@\\s]+@[^@\\s]+$')
        && qStr(d.location, 200) && d.location.size() > 0
        && qStr(d.date, 12)      && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && d.eventType in ['Wedding','Corporate','Private Party','Festival','Other']
        && qStr(d.phone, 40)
        && qStr(d.eventTypeOther, 120)
        && qStr(d.venue, 200)
        && qStr(d.notes, 2000)
        && qStr(d.referrer, 300)
        && qStr(d.utmSource, 100) && qStr(d.utmMedium, 100) && qStr(d.utmCampaign, 120)
        && qOpt(d.setting,  ['Indoor','Outdoor','Both'])
        && qOpt(d.guests,   ['Under 50','50-100','100-200','200+'])
        && qOpt(d.duration, ['1-2 hrs','3-4 hrs','4-5 hrs','5+ hrs'])
        && qOpt(d.hardStop, ['No','Yes','Unsure'])
        && qOpt(d.bandSize, ['Solo/Duo','Small (3-4)','Medium (5-6)','Large (7+)'])
        && qOpt(d.sound,    ['Band Provides','Venue Provides','Unsure'])
        && qOpt(d.lighting, ['Basic','Enhanced','None'])
        && qOpt(d.budget,   ['Under $2k','$2k-$4k','$4k-$6k','$6k+','Prefer not to say'])
        && qOpt(d.urgency,  ['Information Gathering','Ready to Book','Immediate'])
        && d.openToRec is bool
        && qList(d.services, ['Live Band','Cocktail Hour','Ceremony','MC Services'], 4)
        && qList(d.genres,   ['Rock','Pop','Motown','Country','90s'], 5);
    }

    match /quotes/{quoteId} {
      allow create: if isValidNewQuote(quoteId);
      allow read, update, delete: if isAllowedUser();
    }

    // Band members: public read (the shared setlist view needs names/colours),
    // allowlisted write. Contains no email or other PII by design — contact
    // details stay in allowedUsers, which is not publicly readable.
    match /members/{memberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // A member may edit their own display name and colour. Operational flags
      // and googleUid stay admin-only — see touchesAdminOnlyFields().
      allow update: if isAdmin()
        || (isAllowedUser() && ownsMember(memberId) && !touchesAdminOnlyFields());
    }

    // Member profile pages. Separate from `members` (which must stay
    // world-readable so the shared setlist can resolve names and colours) so an
    // UNPUBLISHED draft is genuinely unreadable rather than just hidden by the
    // UI. Anonymous list queries must filter on published == true to satisfy
    // this rule; the admin reads the collection unfiltered.
    match /memberProfiles/{memberId} {
      allow read: if resource.data.published == true || isAllowedUser();
      allow write: if isAdmin() || (isAllowedUser() && ownsMember(memberId));
    }

    // Site settings: public read (the homepage and /request page gate on these),
    // allowlisted write. Single doc: settings/global
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAllowedUser();
    }

    // Song requests: public create (anyone at a show can submit), admin read/update/delete
    match /songRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAllowedUser();
    }
  }
}
